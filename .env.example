# Supabase project credentials (used by the Supabase data sources).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional REST API base (used if you swap Supabase for a REST data source).
VITE_API_BASE_URL=https://api.wasalny.eg

# When 'true', the UI is served from in-memory mock data sources (no backend needed).
VITE_USE_MOCK=true
